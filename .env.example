# Copier ce fichier en .env.local et le compléter (Supabase > Project Settings > API).
# .env.local est ignoré par Git : aucune clé ne doit être publiée.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, uniquement pour le script de création des comptes de démo (jamais côté navigateur).
SUPABASE_SERVICE_ROLE_KEY=
