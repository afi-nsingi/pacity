# Copier ce fichier en .env.local et le compléter (Supabase > Project Settings > API).
# .env.local est ignoré par Git : aucune clé ne doit être publiée.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, uniquement pour le script de création des comptes de démo (jamais côté navigateur).
SUPABASE_SERVICE_ROLE_KEY=
# E-mails aux membres (confirmation, annulation) via Gmail : adresse d'envoi + mot de passe
# d'application Google (myaccount.google.com/apppasswords). Sans ces deux lignes, l'appli
# fonctionne mais n'envoie pas d'e-mail.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Adresse publique de l'appli (bouton « Voir mes réservations » des e-mails).
NEXT_PUBLIC_SITE_URL=
